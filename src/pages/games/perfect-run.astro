---
import { YouTube } from '@astro-community/astro-embed-youtube';
import Layout from '~/layouts/PageLayout.astro';
import Lightbox from '~/components/feed/Lightbox.astro';

const metadata = {
  title: 'Perfect Run',
  description:
    'You can restart as many times as you want, but you only get to run through it one time.\n Built for Code-for-a-Cause Mini Jam 2025.',
};

const facts = [
  { label: 'Platforms', value: 'PC' },
  { label: 'Released', value: 'May 25, 2025' },
  { label: 'Built with', value: 'Godot' },
];

const h2Class = 'text-2xl md:text-3xl font-bold font-heading tracking-tighter mb-4';

---

<Layout metadata={metadata}>

  <!-- Title and intro -->
  <section class="px-4 md:px-6 pt-16 sm:pt-24 pb-4 mx-auto max-w-3xl">
    <h1 class="text-4xl md:text-6xl font-bold font-heading tracking-tighter mb-6">Perfect Run</h1>
    <p class="text-lg md:text-xl text-muted dark:text-slate-400">
      You can restart as many times as you want, but you only get to run through it all one time. Built for Code-for-a-Cause Mini Jam 2025
    </p>
  </section>

  <!-- YouTube Video -->
  <section class="px-4 md:px-6 pb-8 sm:pb-10 mx-auto max-w-3xl">
    <div class="prose lg:prose-xl dark:prose-invert max-w-none">
      <p>
        A game very similar to <a
            href="/games/metroidvaniascii"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-primary dark:hover:text-white"
        >MetroidvaniASCII</a> with a focus on speedrunning rather than puzzle solving. You are building a speedrun one room at a time. You can restart the room as many times as you want, but once you finish a room you can't go back. Each room adds a split to your time which is totalled at the end.
      </p>
    </div>
  </section>

  <!-- Playable build -->
  <section class="px-4 md:px-6 pb-16 sm:pb-24 mx-auto max-w-3xl">
    <h2 class={h2Class}>Play it in your browser</h2>
    <div class="prose lg:prose-xl mb-4 dark:prose-invert max-w-none">
        <p>
            You can play it right here. It's highly recommended to play in full screen. Use the button in the bottom right.
        </p>
    </div>
    
    <div
      class="not-prose relative w-full overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700 shadow-lg bg-black"
      style="aspect-ratio: 1280 / 740;"
    >
      <iframe
        src="https://itch.io/embed-upload/13798932?color=7b7b7b"
        title="Play Perfect Run on itch.io"
        class="absolute inset-0 w-full h-full border-0"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </div>
    <p class="mt-3 text-sm text-muted dark:text-slate-400">
        Having trouble?{" "}
        <a
            href="https://weekie.itch.io/perfect-run"
            target="_blank"
            rel="noopener noreferrer"
            class="underline hover:text-primary dark:hover:text-white"
        >Play it on itch.io</a> instead.
    </p>
  </section>

    <section class="px-4 md:px-6 pb-12 sm:pb-16 mx-auto max-w-3xl">
        <h2 class={h2Class}>About the Game</h2>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
        {
            facts.map((fact) => (
            <div class="rounded-lg border border-gray-700 bg-gray-900 p-4 text-center">
                <p class="text-sm text-gray-400">{fact.label}</p>
                <p class="text-lg font-semibold text-white">{fact.value}</p>
            </div>
            ))
        }
        </div>
    </section>

</Layout>