---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';
// import PostTags from "~/components/blog/Tags.astro";

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  ...(currentPage > 1
    ? [{ text: 'Blog', href: getBlogPermalink() }, { text: `Page ${currentPage}` }]
    : [{ text: 'Blog' }]),
];

const buttonClass =
  'inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-gray-800 bg-black text-white font-semibold text-sm hover:bg-gray-800 transition';

// "Keep reading" buttons under the feed.
const blogs = [
  { text: 'Castle Wars Devlogs', slug: 'castle-wars-devlogs' },
  { text: 'PortalDoom Devlogs', slug: 'portaldoom-devlogs' },
  { text: '20 Game Challenge', slug: '20-game-challenge' },
  { text: "Frank's Radio Show", slug: 'franks-radio-show' },
];

// const allCategories = await findCategories();
// const allTags = await findTags();

const metadata = {
  title: `Blog${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description:
    'Articles about Astro, Tailwind CSS and the AstroWind template: tutorials, customisation guides and web development notes.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>
  <Breadcrumbs bar items={breadcrumbs} />
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Development logs, notes about my progress and what I think is interesting."
      classes={{ container: '!mb-0 md:!mb-0' }}
    >
      The Blogs
    </Headline>
    <!-- lLst of blog posts -->
    <BlogList posts={page.data} />
    <!-- Quick links to the Blog Categories -->
    <div class="mt-6 mb-10 text-center">
      <div class="flex flex-wrap justify-center gap-3">
        {
          blogs.map((blog) => (
            <a href={getPermalink(blog.slug, 'category')} class={buttonClass}>
              {blog.text}
            </a>
          ))
        }
      </div>
    </div>
    <!-- Pagination Links -->
    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    <!--
      <PostTags tags={allCategories} class="mb-2" title="Search by Categories:" isCategory />
      <PostTags tags={allTags}  title="Search by Tags:" />
    -->
  </section>
</Layout>