---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';
import TwitchLive from '~/components/feed/TwitchLive.astro';
import Lightbox from '~/components/feed/Lightbox.astro';
import { getYouTubeVideos } from '~/utils/youtube';
import { getBlueskyPosts } from '~/utils/bluesky';

const metadata = { title: 'Weekiepedia' };

// How many items to show from each source. Raise these for a longer feed.
const VIDEO_COUNT = 10;
const BLUESKY_COUNT = 10;
const BLOG_COUNT = 10;

// Hostnames that count as your own site when a Bluesky post links to a blog post.
const SITE_HOSTS = ['weekienhn.github.io'];

// "Keep reading" buttons under the feed.
const blogs = [
  { text: 'Castle Wars Devlogs', slug: 'castle-wars-devlogs' },
  { text: 'PortalDoom Devlogs', slug: 'portaldoom-devlogs' },
  { text: '20 Game Challenge', slug: '20-game-challenge' },
  { text: "Frank's Radio Show", slug: 'franks-radio-show' },
];

const allVideos = await getYouTubeVideos(50);
const videos = allVideos.slice(0, VIDEO_COUNT);

const allPosts = (await getCollection('post')).filter((p) => !p.data.draft);
const posts = [...allPosts]
  .sort((a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0))
  .slice(0, BLOG_COUNT);

// Cross-post detection: a Bluesky post that links to one of your videos or blog posts
// is dropped, and the video or blog card is kept instead.
const trimPath = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
const videoIds = new Set(allVideos.map((v) => v.id));
const blogPaths = new Set(allPosts.map((p) => trimPath(getPermalink(p.id, 'post'))));

const youtubeId = (url: string) =>
  url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?(?:[^#]*&)?v=|shorts\/|live\/|embed\/))([\w-]{11})/)?.[1];

const isCrossPost = (links: string[]) =>
  links.some((link) => {
    const id = youtubeId(link);
    if (id && videoIds.has(id)) return true;
    try {
      const u = new URL(link);
      return SITE_HOSTS.includes(u.hostname) && blogPaths.has(trimPath(u.pathname));
    } catch {
      return false;
    }
  });

const allSkeets = await getBlueskyPosts(100);
const keptSkeets = allSkeets.filter((s) => !isCrossPost(s.links));
const skeets = keptSkeets.slice(0, BLUESKY_COUNT);

console.log(
  `[feed] videos=${videos.length} bluesky=${skeets.length} (dropped ${allSkeets.length - keptSkeets.length} cross-posts) blog=${posts.length}`
);

const badgeClass = {
  Video: 'bg-red-100 text-red-700 dark:bg-red-900/40 dark:text-red-300',
  Blog: 'bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300',
  Bluesky: 'bg-sky-100 text-sky-700 dark:bg-sky-900/40 dark:text-sky-300',
};

const cardClass = 'overflow-hidden rounded-lg border border-gray-300 dark:border-gray-700';

const buttonClass =
  'inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 font-semibold text-sm hover:bg-gray-100 dark:hover:bg-slate-800 transition';

const feed = [
  ...videos.map((v) => ({
    type: 'Video',
    id: v.id,
    title: v.title,
    date: v.published,
    href: v.url,
    external: true,
    image: v.thumbnail,
    images: [],
    text: v.description,
  })),
  ...skeets.map((s) => ({
    type: 'Bluesky',
    id: s.id,
    title: '',
    date: s.date,
    href: s.url,
    external: true,
    image: '',
    images: s.images,
    text: s.text,
  })),
  ...posts.map((p) => ({
    type: 'Blog',
    id: p.id,
    title: p.data.title,
    date: p.data.publishDate ?? new Date(0),
    href: getPermalink(p.id, 'post'),
    external: false,
    image: '',
    images: [],
    text: p.data.excerpt ?? '',
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 mx-auto max-w-5xl">
    <TwitchLive endpoint="https://twitch-live.YOUR-SUBDOMAIN.workers.dev" channel="YOUR_TWITCH_NAME" />

    <h1 class="text-4xl md:text-5xl font-bold font-heading tracking-tighter mb-10">Latest</h1>

    <div id="feed" class="invisible">
      <ul class="space-y-6">
        {
          feed.map((item, index) => (
            <li data-feed-item data-index={index}>
              {item.type === 'Bluesky' ? (
                <article class={cardClass}>
                  {item.images.length > 0 && (
                    <div class:list={['grid gap-0.5', item.images.length === 1 ? 'grid-cols-1' : 'grid-cols-2']}>
                      {item.images.map((img, i) => (
                        <button
                          type="button"
                          data-gallery={item.id}
                          data-full={img.full}
                          data-alt={img.alt}
                          aria-label={img.alt ? `View image: ${img.alt}` : 'View image'}
                          class:list={[
                            'block overflow-hidden cursor-zoom-in',
                            item.images.length === 3 && i === 0 ? 'col-span-2' : '',
                          ]}
                        >
                          <img
                            src={img.thumb}
                            alt={img.alt}
                            loading="lazy"
                            style={
                              item.images.length === 1
                                ? `aspect-ratio: ${img.ratio ?? 1.5}; max-height: 24rem;`
                                : undefined
                            }
                            class:list={[
                              'w-full object-cover hover:opacity-90 transition',
                              item.images.length > 1 ? 'aspect-square' : '',
                            ]}
                          />
                        </button>
                      ))}
                    </div>
                  )}
                  <div class="p-5">
                    <p class="text-sm text-gray-500 dark:text-slate-400 mb-1">
                      <span
                        class:list={[
                          'inline-block px-2 py-0.5 mr-2 rounded text-xs font-semibold',
                          badgeClass[item.type],
                        ]}
                      >
                        {item.type}
                      </span>
                      {getFormattedDate(item.date)}
                    </p>
                    {item.text && <p class="mt-2 text-muted dark:text-slate-400 whitespace-pre-line">{item.text}</p>}
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block mt-3 text-sm underline"
                    >
                      View on Bluesky →
                    </a>
                  </div>
                </article>
              ) : item.type === 'Video' ? (
                <article class={cardClass}>
                  <a href={item.href} target="_blank" rel="noopener noreferrer" class="block">
                    <img
                      src={item.image}
                      alt=""
                      loading="lazy"
                      class="w-full aspect-video object-cover hover:opacity-90 transition"
                    />
                  </a>
                  <div class="p-5">
                    <p class="text-sm text-gray-500 dark:text-slate-400 mb-1">
                      <span
                        class:list={[
                          'inline-block px-2 py-0.5 mr-2 rounded text-xs font-semibold',
                          badgeClass[item.type],
                        ]}
                      >
                        {item.type}
                      </span>
                      {getFormattedDate(item.date)}
                    </p>
                    <h2 class="text-xl sm:text-2xl font-bold font-heading">{item.title}</h2>
                    {
                      item.text && (
                        <p class="mt-2 text-muted dark:text-slate-400 whitespace-pre-line line-clamp-4">{item.text}</p>
                      )
                    }
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-block mt-3 text-sm underline"
                    >
                      Watch on YouTube →
                    </a>
                  </div>
                </article>
              ) : (
                <a href={item.href} class:list={['block hover:shadow-lg transition', cardClass]}>
                  <div class="p-5">
                    <p class="text-sm text-gray-500 dark:text-slate-400 mb-1">
                      <span
                        class:list={[
                          'inline-block px-2 py-0.5 mr-2 rounded text-xs font-semibold',
                          badgeClass[item.type],
                        ]}
                      >
                        {item.type}
                      </span>
                      {getFormattedDate(item.date)}
                    </p>
                    <h2 class="text-xl sm:text-2xl font-bold font-heading">{item.title}</h2>
                    {item.text && <p class="mt-2 text-muted dark:text-slate-400">{item.text}</p>}
                  </div>
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-14 text-center">
      <h2 class="text-2xl font-bold font-heading mb-6">Like what you see? Keep reading</h2>

      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://youtube.com/@weekie" target="_blank" rel="noopener noreferrer" class={buttonClass}>
          <Icon name="tabler:brand-youtube" class="w-5 h-5" />
          More videos on YouTube
        </a>
        <a
          href="https://bsky.app/profile/weekiepedia.org"
          target="_blank"
          rel="noopener noreferrer"
          class={buttonClass}
        >
          <Icon name="tabler:brand-bluesky" class="w-5 h-5" />
          More posts on Bluesky
        </a>
      </div>

      <p class="mt-8 mb-3 text-sm text-gray-500 dark:text-slate-400">Blogs</p>
      <div class="flex flex-wrap justify-center gap-3">
        {
          blogs.map((blog) => (
            <a href={getPermalink(blog.slug, 'category')} class={buttonClass}>
              {blog.text}
            </a>
          ))
        }
      </div>
    </div>

    <Lightbox />
    <noscript><style>#feed { visibility: visible !important; }</style></noscript>

    <script>
      const desktop = window.matchMedia('(min-width: 768px)');
      let resizeTimer: number | undefined;
      let lastWidth = window.innerWidth;

      function layoutFeed() {
        const feed = document.getElementById('feed');
        if (!feed) return;

        const items = Array.from(feed.querySelectorAll<HTMLElement>('[data-feed-item]')).sort(
          (a, b) => Number(a.dataset.index) - Number(b.dataset.index)
        );
        const columnCount = desktop.matches ? 2 : 1;

        const columns = Array.from({ length: columnCount }, () => {
          const ul = document.createElement('ul');
          ul.className = 'flex flex-col gap-6 flex-1 min-w-0';
          return ul;
        });

        feed.replaceChildren(...columns);
        feed.className = 'flex items-start gap-6';

        // Newest first: each card goes into whichever column is currently shorter.
        for (const item of items) {
          const shortest = columns.reduce((a, b) => (a.offsetHeight <= b.offsetHeight ? a : b));
          shortest.appendChild(item);
        }
      }

      document.addEventListener('astro:page-load', () => {
        layoutFeed();
        document.fonts?.ready.then(layoutFeed);
      });

      desktop.addEventListener('change', layoutFeed);

      window.addEventListener('resize', () => {
        if (window.innerWidth === lastWidth) return; // ignore mobile address-bar resizes
        lastWidth = window.innerWidth;
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(layoutFeed, 150);
      });
    </script>
  </section>
</Layout>